# TELEGRAM
# User mode (полноценный поиск по истории):
#   TELEGRAM_API_ID + TELEGRAM_API_HASH + TELEGRAM_PHONE
#   При первом запуске потребуется код из Telegram.
#   Получить: https://my.telegram.org/apps
TELEGRAM_API_ID=""
TELEGRAM_API_HASH=""
TELEGRAM_PHONE=""

# Bot mode (ограниченный — только последние сообщения):
#   TELEGRAM_BOT_TOKEN
#   Получить: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=""

# GITHUB
# GitHub Personal Access Token (опционально — для 5000 req/h вместо 60)
GITHUB_TOKEN=""

# HUGGING FACE
# HF Token (опционально — для расширенного доступа)
HF_TOKEN=""

# ARXIV
# arXiv API Token (опционально)
ARXIV_TOKEN=""
